# Normaliza todo a LF (Linux/Docker safe)
* text=auto eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts SIEMPRE LF
*.sh text eol=lf

# YAML / ENV / CONFIGS
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.conf text eol=lf
*.ini text eol=lf

# Código
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary